{
  "name": "@nanoagent/plugins",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24 <25",
    "bun": ">=1.3.13"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@nanoagent/kernel": "0.0.0"
  },
  "devDependencies": {
    "@nanoagent/kernel": "file:../kernel",
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.13",
    "prettier": "3.8.3",
    "typescript": "^6.0.3"
  }
}
