{
  "name": "@nanoagent/kernel",
  "version": "0.1.2",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24 <25",
    "bun": ">=1.3.13"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.96",
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/azure": "^3.0.54",
    "@ai-sdk/baseten": "^1.0.44",
    "@ai-sdk/cerebras": "^2.0.45",
    "@ai-sdk/cohere": "^3.0.30",
    "@ai-sdk/deepinfra": "^2.0.45",
    "@ai-sdk/deepseek": "^2.0.29",
    "@ai-sdk/fireworks": "^2.0.46",
    "@ai-sdk/google": "^3.0.79",
    "@ai-sdk/google-vertex": "^4.0.125",
    "@ai-sdk/groq": "^3.0.35",
    "@ai-sdk/mistral": "^3.0.30",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/perplexity": "^3.0.29",
    "@ai-sdk/provider-utils": "^4.0.23",
    "@ai-sdk/togetherai": "^2.0.45",
    "@ai-sdk/vercel": "^2.0.49",
    "@ai-sdk/xai": "^3.0.83",
    "ai": "^6.0.191",
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.13",
    "prettier": "3.8.3",
    "typescript": "^6.0.3"
  }
}
