{
  "compilerOptions": {
    "declaration": true,
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "paths": {
      "@nanoagent/kernel": ["../kernel/dist/index.d.ts"]
    },
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "typeRoots": ["../kernel/node_modules/@types", "../kernel/node_modules"],
    "types": ["bun-types"]
  },
  "include": ["src/**/*.ts"]
}
