{
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["bun-types"],
    "paths": {
      "@ai-sdk/openai": [
        "../../packages/kernel/node_modules/@ai-sdk/openai"
      ],
      "@ai-sdk/openai/*": [
        "../../packages/kernel/node_modules/@ai-sdk/openai/*"
      ],
      "ai": ["../../packages/kernel/node_modules/ai"],
      "ai/*": ["../../packages/kernel/node_modules/ai/*"],
      "@nanoagent/kernel": ["../../packages/kernel/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
